{
  "name": "@limechat/react-native-widget",
  "version": "0.0.6-beta",
  "description": "React Native SDK for LimeChat widget integration",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "src/components/",
    "src/hooks/",
    "src/utils/",
    "src/assets/",
    "src/constants.js",
    "src/index.js",
    "src/LimeChatWidget.js",
    "src/styles.js",
    "src/utils.js",
    "dist/",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && cp -r src/assets dist/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "yarn lint && yarn type-check",
    "prepare": "husky || (npm run build && npm run cleanup-for-clients) || true",
    "cleanup-for-clients": "rm -rf src/__tests__ babel.config.js .eslintrc.js tsconfig.json jest.config.js",
    "postinstall": "(test -d dist || npm run build || true)",
    "prepublishOnly": "yarn validate",
    "clean": "rm -rf dist build node_modules yarn.lock .turbo .next .cache",
    "prepack": "yarn clean && yarn install --frozen-lockfile --production=false && yarn build && yarn install --production=true",
    "release": "scripts/release.sh",
    "release:patch": "scripts/release.sh patch",
    "release:minor": "scripts/release.sh minor",
    "release:major": "scripts/release.sh major",
    "prerelease": "scripts/prerelease.sh",
    "prerelease:alpha": "scripts/prerelease.sh alpha",
    "prerelease:beta": "scripts/prerelease.sh beta",
    "prerelease:rc": "scripts/prerelease.sh rc",
    "tags": "scripts/show-tags.sh"
  },
  "keywords": [
    "react-native",
    "chat",
    "widget",
    "limechat",
    "customer-support",
    "mobile",
    "sdk",
    "typescript"
  ],
  "author": "LimeChat Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limechat/react-native-widget.git"
  },
  "bugs": {
    "url": "https://github.com/limechat/react-native-widget/issues"
  },
  "homepage": "https://github.com/limechat/react-native-widget#readme",
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "react-native-modal": ">=11.0.0",
    "react-native-webview": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-modal": {
      "optional": false
    },
    "react-native-webview": {
      "optional": false
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.44.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "lint-staged": "^15.2.10",
    "metro-react-native-babel-preset": "^0.76.0",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-modal": "^13.0.1",
    "react-native-webview": "^13.13.5",
    "react-test-renderer": "^18.2.0",
    "ts-jest": "^28.0.8",
    "typescript": "^5.1.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "npm test --findRelatedTests --passWithNoTests"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "jest": {
    "preset": "react-native",
    "testMatch": [
      "<rootDir>/src/__tests__/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-webview|react-native-modal|@react-native-community)/)"
    ],
    "collectCoverageFrom": [
      "src/utils.js",
      "src/constants.js",
      "!src/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testEnvironment": "node"
  }
}
